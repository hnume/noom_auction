<% content_for :title, "รายการประมูล · Noom Auction" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;800&display=swap" rel="stylesheet">
<% end %>

<div class="shop">
  <aside class="shop__menu">
    <%= link_to root_path, class: "shop__brand" do %>Noom <span>Auction</span><% end %>
    <p class="shop__menu-label">เมนู</p>
    <nav class="shop__nav">
      <%= link_to "Event", auctions_path, class: "shop__nav-link shop__nav-link--on", aria: { current: "page" } %>
      <a href="#" class="shop__nav-link">My Event</a>
      <a href="#" class="shop__nav-link">My Product</a>
      <a href="#" class="shop__nav-link">Register Product</a>
    </nav>
    <p class="shop__menu-note">🔒 My Event, My Product และ Register Product ต้อง login ก่อนใช้งาน</p>
  </aside>

  <main class="shop__main">
    <header class="shop__top">
      <div>
        <h1 class="shop__title">Event</h1>
        <p class="shop__subtitle">รายการสินค้าที่เปิดประมูล</p>
      </div>
      <div class="shop__actions">
        <a href="#" class="btn btn--primary">+ Create Event</a>
        <details class="profile">
          <summary class="profile__avatar" aria-label="บัญชีผู้ใช้">👤</summary>
          <div class="profile__menu">
            <a href="#">Login</a>
            <a href="#">Profile</a>
            <a href="#">Logout</a>
          </div>
        </details>
      </div>
    </header>

    <%= form_with url: auctions_path, method: :get, class: "toolbar", data: { turbo: false } do %>
      <div class="toolbar__chips">
        <%= link_to auctions_path(sort: @sort, price: @price), class: ["chip", ("chip--on" if @status.nil?)] do %>
          ทั้งหมด <span class="chip__count"><%= @counts["all"] %></span>
        <% end %>
        <% AuctionsController::STATUSES.each do |key, label| %>
          <%= link_to auctions_path(status: key, sort: @sort, price: @price), class: ["chip", "chip--#{key}", ("chip--on" if @status == key)] do %>
            <%= label %> <span class="chip__count"><%= @counts.fetch(key, 0) %></span>
          <% end %>
        <% end %>
      </div>
      <div class="toolbar__selects">
        <%= hidden_field_tag :status, @status if @status %>
        <label class="toolbar__sort">
          ช่วงราคา
          <%= select_tag :price,
                options_for_select(AuctionsController::PRICE_RANGES.map { |k, v| [v[:label], k] }, @price),
                include_blank: "ทุกราคา", onchange: "this.form.submit()" %>
        </label>
        <label class="toolbar__sort">
          เรียงตาม
          <%= select_tag :sort, options_for_select(AuctionsController::SORTS.invert, @sort), onchange: "this.form.submit()" %>
        </label>
      </div>
    <% end %>

    <% if @auctions.empty? %>
      <p class="empty">ไม่พบรายการที่ตรงกับตัวกรอง</p>
    <% else %>
      <div class="grid">
        <% @auctions.each do |a| %>
          <article class="card card--<%= a[:status] %>">
            <div class="card__image">
              <span class="card__emoji" aria-hidden="true"><%= a[:emoji] %></span>
              <% if a[:photo] %>
                <%= image_tag photo_url(a[:photo]), alt: a[:title], class: "card__photo", loading: "lazy", decoding: "async" %>
                <%= link_to "ภาพ: #{photo_credit(a[:photo])}", photo_page_url(a[:photo]),
                      class: "card__credit", target: "_blank", rel: "noopener" %>
              <% end %>
              <span class="badge badge--<%= a[:status] %>"><%= AuctionsController::STATUSES[a[:status]] %></span>
              <span class="countdown <%= 'countdown--urgent' if closing_soon?(a) %>">⏱ <%= time_left_label(a) %></span>
            </div>
            <div class="card__body">
              <p class="card__meta">
                <span><%= a[:product] %></span>
                <span class="tag"><%= auction_type_label(a[:type]) %></span>
              </p>
              <h2 class="card__title"><%= a[:title] %></h2>
              <p class="card__price-label">
                <%= { "upcoming" => "ราคาเริ่มต้น", "ended" => "ราคาปิด" }.fetch(a[:status], "ราคาล่าสุด") %>
              </p>
              <p class="card__price">฿<%= number_with_delimiter(a[:price]) %></p>
              <dl class="card__dates">
                <div><dt>เริ่ม</dt><dd><%= thai_datetime(a[:start_at]) %></dd></div>
                <div><dt>ปิด</dt><dd><%= thai_datetime(a[:stop_at]) %></dd></div>
              </dl>
              <a href="#" class="btn btn--block <%= a[:status] == 'live' ? 'btn--primary' : 'btn--ghost' %>">
                <%= a[:status] == "live" ? "ประมูลเลย" : "ดูรายละเอียด" %>
              </a>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>

    <% if @total_pages > 1 %>
      <nav class="pager" aria-label="หน้า">
        <% (1..@total_pages).each do |p| %>
          <%= link_to p, auctions_path(page: p, status: @status, sort: @sort, price: @price), class: ["pager__link", ("pager__link--on" if p == @page)] %>
        <% end %>
      </nav>
    <% end %>
  </main>
</div>
